{
  "name": "pushrow",
  "version": "0.1.0",
  "description": "Push LinkedIn and CRM records to Clay tables from Chrome.",
  "keywords": [
    "chrome-extension",
    "clay",
    "linkedin",
    "hubspot",
    "salesforce",
    "attio",
    "wxt"
  ],
  "homepage": "https://github.com/danguenet/pushrow#readme",
  "bugs": {
    "url": "https://github.com/danguenet/pushrow/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/danguenet/pushrow.git"
  },
  "type": "module",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "assets": "node scripts/render-assets.mjs && npm run store:screenshot",
    "store:screenshot": "npm run build && node scripts/capture-store-screenshot.mjs",
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "prepare": "wxt prepare",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "npm run build && playwright test",
    "package:check": "node --test scripts/*.test.mjs && node scripts/validate-extension.mjs",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm run test:coverage && npm run build && npm run package:check"
  },
  "dependencies": {
    "lucide-react": "^1.27.0",
    "re2js": "^2.8.6",
    "react": "^19.2.7",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.0",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "^4.1.10",
    "@wxt-dev/module-react": "^1.2.2",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^17.8.0",
    "jsdom": "^30.0.0",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10",
    "wxt": "^0.21.1"
  },
  "overrides": {
    "adm-zip": "0.6.0",
    "esbuild": "0.28.1",
    "multimatch": "8.0.0",
    "shell-quote": "1.9.0",
    "tmp": "0.2.7",
    "uuid": "11.1.1"
  }
}
